# Copy to .env and fill in. .env is gitignored — never commit the real values.
#
# Database connection string used by the Alembic migrations and by
# `vb_kb load` / `vb_kb stats --dsn`. Note the +psycopg driver prefix.
#
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Take the DIRECT connection (port 5432), not the transaction pooler (6543):
# migrations need session-level features the transaction pooler does not allow.
# Then swap the scheme to postgresql+psycopg:// and URL-encode any special
# characters in the password.
#
VB_DB_DSN=postgresql+psycopg://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres
